rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['habitsk50@gmail.com', 'admin@noordaily.com'];
    }

    // Public app content can be read by users; only signed-in administrators can change it.
    match /categories/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /posts/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /quizzes/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /calendar_events/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /app_config/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /prayer_settings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Audit logs are private to authorized administrators.
    match /audit_logs/{documentId} {
      allow read, write: if isAdmin();
    }

    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
